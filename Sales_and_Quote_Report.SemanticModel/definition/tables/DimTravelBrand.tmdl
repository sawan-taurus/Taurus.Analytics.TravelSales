	column TravelBrand
		dataType: string
		lineageTag: a16d402e-9589-4e8a-a6e6-69eb9e286530
		summarizeBy: none
		sourceColumn: TravelBrand

		annotation SummarizationSetBy = Automatic

	column Brand = ```
			
			SWITCH(
			    TRUE(),
			    CONTAINSSTRING([TravelBrand], "oasis_travel"), "Oasis",
			    CONTAINSSTRING([TravelBrand], "sale_travel"), "Sales",
			    CONTAINSSTRING([TravelBrand], "atoz_travel"), "Atoz",
			    CONTAINSSTRING([TravelBrand], "start_travel"), "Start",
			    CONTAINSSTRING([TravelBrand], "trusted_ins"), "Trusted",
			    CONTAINSSTRING([TravelBrand], "switched_on"), "SOI",
			    CONTAINSSTRING([TravelBrand], "viva_ins"), "Viva",
			    [TravelBrand]
			)
			
			```
		lineageTag: 0893f31e-dc17-477e-985f-62f577d707a7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column FilteredBrands = ```
			
			CALCULATETABLE(
			    VALUES(DimTravelBrand[Brand]),
			    DimTravelBrand[TravelBrandID] IN VALUES(FactSalesAnalysis[TravelBrandID])
			)
			
			```
		lineageTag: ce4a5d44-ba01-46a9-874d-3666287bff46
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

