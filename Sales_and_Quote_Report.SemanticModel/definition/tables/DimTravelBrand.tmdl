table DimTravelBrand
	lineageTag: 6809c075-e03e-4a55-99aa-2c5363edebf0

	column TravelBrandID
		dataType: int64
		formatString: 0
		lineageTag: 38aacbd3-d472-441a-9027-3f89ad6c72d5
