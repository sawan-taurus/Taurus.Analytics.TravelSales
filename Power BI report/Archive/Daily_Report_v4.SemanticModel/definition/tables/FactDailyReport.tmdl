table FactDailyReport
	lineageTag: 48d48c5b-3e5f-4e30-839e-5c8b56441aec

	measure ShowYesterday =
			
			IF (
			    SELECTEDVALUE('DimDate'[Date]) = TODAY() - 1,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 8a2dee00-6293-4f22-b832-d08262532dc5

	measure ShowData =
			
			VAR SelectedDate = SELECTEDVALUE('DimDate'[Date], TODAY() - 1)
			RETURN
			    IF(SelectedDate = TODAY() - 1, 1, 1)
		formatString: 0
		lineageTag: 8cd63d56-1a34-4d2e-8edb-b7316e27b5f4

	measure DateToUse =
			
			IF (
			    ISFILTERED('DimDate'[Date]),
			    SELECTEDVALUE('DimDate'[Date]),
			    TODAY() - 1
			)
		formatString: General Date
		lineageTag: 9bb78bde-0001-4527-9c94-51aef4d467f5

	measure YesterdayFilteredValue = ```
			
			CALCULATE(
			    SUM('FactDailyReport'[DateVol]),  
			    'DimDate'[Date] = TODAY() - 2,
			    'DimSchemeSubSet'[SchemeSubset] IN {"Start", "SOI", "Trusted", "Atoz", "Oasis"}
			)
			```
		lineageTag: 02a42150-9a30-4164-a2d5-9670bc00d1e0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Previous Day Volume' =
			
			VAR SelectedDate = SELECTEDVALUE(DimDate[Date])
			RETURN
			IF (
			    NOT ISBLANK(SelectedDate),
			    CALCULATE(
			        SUM(FactDailyReport[DateVol]),
			        FILTER(
			            ALL(DimDate),
			            DimDate[Date] = SelectedDate - 1
			        )
			    )
			)
		lineageTag: 654c937a-0a1b-4e25-80b6-8c8bb8629ede

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure DateVol_MTD_ExclToday = ```
			
			VAR TodayDate = TODAY()
			VAR StartOfMonthToday = DATE(YEAR(TodayDate), MONTH(TodayDate), 1)
			VAR EndDate = TodayDate - 1
			RETURN
			CALCULATE(
			    SUM(FactDailyReport[DateVol]),
			    FILTER(
			        DimDate,
			        DimDate[Date] >= StartOfMonthToday &&
			        DimDate[Date] <= EndDate
			    )
			)
			
			```
		lineageTag: 79565e97-69d9-4941-a2a3-41bfaea8c3e4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Previous Day Retail' =
			
			VAR SelectedDate = SELECTEDVALUE(DimDate[Date])
			RETURN
			IF (
			    NOT ISBLANK(SelectedDate),
			    CALCULATE(
			        SUM(FactDailyReport[DateRetail]),
			        FILTER(
			            ALL(DimDate),
			            DimDate[Date] = SelectedDate - 1
			        )
			    )
			)
		lineageTag: b0fe68a8-09b2-454a-a9ab-00a932d468da

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure DateVol_PreviousMonth_ExclToday = ```
			
			VAR TodayDate = TODAY()
			VAR DayNum = DAY(TodayDate) - 1
			VAR FirstDayOfCurrentMonth = DATE(YEAR(TodayDate), MONTH(TodayDate), 1)
			VAR LastDayOfPreviousMonth = FirstDayOfCurrentMonth - 1
			VAR FirstDayOfPreviousMonth = DATE(YEAR(LastDayOfPreviousMonth), MONTH(LastDayOfPreviousMonth), 1)
			
			-- Use the lesser of "DayNum" or the actual last day of the previous month
			VAR EndDay = MIN(DayNum, DAY(LastDayOfPreviousMonth))
			VAR EndDate = DATE(YEAR(FirstDayOfPreviousMonth), MONTH(FirstDayOfPreviousMonth), EndDay)
			
			RETURN
			CALCULATE(
			    SUM(FactDailyReport[DateVol]),
			    FILTER(
			        DimDate,
			        DimDate[Date] >= FirstDayOfPreviousMonth &&
			        DimDate[Date] <= EndDate
			    )
			)
			
			```
		lineageTag: c181c300-74a4-464a-855f-4edecef4114f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure DateRetail_MTD_ExclToday = ```
			
			VAR TodayDate = TODAY()
			VAR StartOfMonthToday = DATE(YEAR(TodayDate), MONTH(TodayDate), 1)
			VAR EndDate = TodayDate - 1
			RETURN
			CALCULATE(
			    SUM(FactDailyReport[DateRetail]),
			    FILTER(
			        DimDate,
			        DimDate[Date] >= StartOfMonthToday &&
			        DimDate[Date] <= EndDate
			    )
			)
			
			```
		lineageTag: 30e68f49-ecf5-4f2d-a4f1-da89e5235a1a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure DateRetail_PreviousMonth_ExclToday = ```
			
			VAR TodayDate = TODAY()
			VAR DayNum = DAY(TodayDate) - 1
			VAR FirstDayOfCurrentMonth = DATE(YEAR(TodayDate), MONTH(TodayDate), 1)
			VAR LastDayOfPreviousMonth = FirstDayOfCurrentMonth - 1
			VAR FirstDayOfPreviousMonth = DATE(YEAR(LastDayOfPreviousMonth), MONTH(LastDayOfPreviousMonth), 1)
			
			-- Use the lesser of "DayNum" or the actual last day of the previous month
			VAR EndDay = MIN(DayNum, DAY(LastDayOfPreviousMonth))
			VAR EndDate = DATE(YEAR(FirstDayOfPreviousMonth), MONTH(FirstDayOfPreviousMonth), EndDay)
			
			RETURN
			CALCULATE(
			    SUM(FactDailyReport[DateRetail]),
			    FILTER(
			        DimDate,
			        DimDate[Date] >= FirstDayOfPreviousMonth &&
			        DimDate[Date] <= EndDate
			    )
			)
			
			```
		lineageTag: 9a48d72d-c356-42f4-8411-3d3117187419

		annotation PBI_FormatHint = {"isGeneralNumber":true}

