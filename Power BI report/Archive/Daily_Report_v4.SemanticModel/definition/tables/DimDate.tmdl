	column DateId
		dataType: int64
		formatString: 0
		lineageTag: f9536f72-c05e-43e9-86fe-1a45f32361a0
		summarizeBy: none
		sourceColumn: DateId

		annotation SummarizationSetBy = Automatic

	column date_latest =
			
			VAR MaxFactDateId = CALCULATE(
			    MAX(factdailyreport[DateId]),
			    ALL(factdailyreport)
			)
			RETURN
			IF (
			    'dimdate'[DateId] = MaxFactDateId,
			    "Latest",
			    FORMAT(CONCATENATE(
			        DAY('dimdate'[Date]),
			        "-" &
			        RIGHT("0" & MONTH('dimdate'[Date]), 2) &
			        "-" &
			        YEAR('dimdate'[Date])
			    ), "yyyy-mm-dd")
			)
		lineageTag: bb659941-b3d1-4bbe-8880-eb5151385f25
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column date_display =
			
			VAR YesterdayDateId = CALCULATE(
			    MAX(factdailyreport[DateId]) - 1,
			    ALL(factdailyreport)
			)
			RETURN
			IF (
			    'dimdate'[DateId] = YesterdayDateId,
			    "Yesterday",
			    FORMAT('dimdate'[Date], "dd-MM-yyyy")
			)
		lineageTag: 62359e0c-1875-4590-a57a-1dd3f2d5e7a5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column DateSlicer = If(DimDate[Date]=Today(),"Yesterday's Date",FORMAT(DimDate[Date],"yyyy-mm-dd"))
		lineageTag: 6e0a6f68-bb24-49b0-bf35-dbe78414f9e3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column IsYesterday = IF(DimDate[Date] = TODAY() - 1, 1, 0)
		formatString: 0
		lineageTag: 7e01052b-fda4-48a6-b6e6-49180918f895
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column SlicerDate =
			SWITCH(
			    TRUE(),
			    'DimDate'[Date] = TODAY(), "Today",
			    'DimDate'[Date] = TODAY() - 1, "Latest",
			    FORMAT('DimDate'[Date], "YYYY/MM/DD")
			)
		lineageTag: 54949961-92eb-4508-85ca-5428d54239f7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition DimDate = m
