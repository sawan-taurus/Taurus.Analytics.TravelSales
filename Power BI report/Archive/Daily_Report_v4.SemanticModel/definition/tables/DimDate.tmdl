table DimDate
	lineageTag: 4580a95d-3d1f-4e51-adb8-e0a6ec484959

	measure Measure =
			
			IF (
			    COUNTROWS(RELATEDTABLE(FactDailyReport))>0,
			    1,
			    0
			    )
		formatString: 0
		lineageTag: 92b30d26-9d55-4ec3-bb09-85f55c9c853d

	measure DefaultYesterday =
			
			VAR Yesterday = TODAY() - 1
			RETURN
			IF(MAX(DimDate[Date]) = Yesterday, 1, 0)
		formatString: 0
		lineageTag: 278d0ce6-afdc-4346-bffc-9baa8b566cd4

