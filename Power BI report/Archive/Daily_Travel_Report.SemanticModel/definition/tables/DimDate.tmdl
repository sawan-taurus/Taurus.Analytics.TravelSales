	column SlicerDate = ```
			
			SWITCH(
			    TRUE(),
			    'DimDate'[Date] = TODAY(), "Today",
			    'DimDate'[Date] = TODAY() - 1, "Latest",
			    YEAR('DimDate'[Date]) & "/" &
			    RIGHT("0" & MONTH('DimDate'[Date]), 2) & "/" &
			    RIGHT("0" & DAY('DimDate'[Date]), 2)
			)
			
			```
		lineageTag: 8ed4118b-eabd-4c17-94db-d60d358eb542
		summarizeBy: none

