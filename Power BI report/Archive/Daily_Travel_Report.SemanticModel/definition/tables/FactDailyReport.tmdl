table FactDailyReport
	lineageTag: b19a8b70-599e-455c-bbb8-fddb20426430

	measure 'Previous Day Volume' =
			
			VAR SelectedDate = SELECTEDVALUE(DimDate[Date])
			RETURN
			IF (
			    NOT ISBLANK(SelectedDate),
			    CALCULATE(
			        SUM(FactDailyReport[DateVol]),
			        FILTER(
			            ALL(DimDate),
			            DimDate[Date] = SelectedDate - 1
			        )
			    )
			)
		lineageTag: 0294dc1b-2244-4e30-bf94-5ca76ed4bf25

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Previous Day Retail' =
			
			VAR SelectedDate = SELECTEDVALUE(DimDate[Date])
			RETURN
			IF (
			    NOT ISBLANK(SelectedDate),
			    CALCULATE(
			        SUM(FactDailyReport[DateRetail]),
			        FILTER(
			            ALL(DimDate),
			            DimDate[Date] = SelectedDate - 1
			        )
			    )
			)
		lineageTag: f56e2450-f506-43c2-845d-e1540ee1b66d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure DateVol_CurrentMonth_ExclToday = ```
			
			VAR TodayDate = TODAY()
			VAR FirstDayOfCurrentMonth = DATE(YEAR(TodayDate), MONTH(TodayDate), 1)
			VAR Yesterday = TodayDate - 1
			
			RETURN
			CALCULATE(
			    SUM(FactDailyReport[DateVol]),
			    DimDate[Date] >= FirstDayOfCurrentMonth &&
			    DimDate[Date] <= Yesterday
			)
			
			
			```
		lineageTag: c83e5ffa-073f-44a9-a1c4-18cc19036273

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure DateVol_PreviousMonth_ExclToday = ```
			
			VAR TodayDate = TODAY()
			VAR FirstDayOfCurrentMonth = DATE(YEAR(TodayDate), MONTH(TodayDate), 1)
			VAR LastDayOfPreviousMonth = FirstDayOfCurrentMonth - 1
			VAR FirstDayOfPreviousMonth = DATE(YEAR(LastDayOfPreviousMonth), MONTH(LastDayOfPreviousMonth), 1)
			
			RETURN
			CALCULATE(
			    SUM(FactDailyReport[DateVol]),
			    DimDate[Date] >= FirstDayOfPreviousMonth &&
			    DimDate[Date] <= LastDayOfPreviousMonth
			)
			
			```
		lineageTag: b9bc939f-f76f-41fd-b933-f21d8b8046c1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure DateRetail_MTD_ExclToday = ```
			
			VAR TodayDate = TODAY()
			VAR FirstDayOfCurrentMonth = DATE(YEAR(TodayDate), MONTH(TodayDate), 1)
			VAR Yesterday = TodayDate - 1
			
			RETURN
			CALCULATE(
			    SUM(FactDailyReport[DateRetail]),
			    DimDate[Date] >= FirstDayOfCurrentMonth &&
			    DimDate[Date] <= Yesterday
			)
			
			```
		lineageTag: f6e6aae9-0bb0-479a-8b00-377a5fd71340

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure DateRetail_PreviousMonth_ExclToday = ```
			
			VAR TodayDate = TODAY()
			VAR FirstDayOfCurrentMonth = DATE(YEAR(TodayDate), MONTH(TodayDate), 1)
			VAR LastDayOfPreviousMonth = FirstDayOfCurrentMonth - 1
			VAR FirstDayOfPreviousMonth = DATE(YEAR(LastDayOfPreviousMonth), MONTH(LastDayOfPreviousMonth), 1)
			
			RETURN
			CALCULATE(
