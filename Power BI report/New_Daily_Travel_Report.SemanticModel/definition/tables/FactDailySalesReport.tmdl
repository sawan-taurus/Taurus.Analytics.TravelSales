	measure BudgetVolTotal = ```
			
			CALCULATE(
			    SUM('FactDailyForecastReport'[Budget_Volume]),
			    FILTER(
			        'DimSchemeSubset',
			        CONTAINSSTRING('DimSchemeSubset'[Brand], "Total")
			    )
			)
			
			```
		formatString: 0
		lineageTag: 9810e8e6-bdfc-44f9-9c47-40bb8a639220

	measure MTDVol_LastDay_PreviousMonth = ```
			
			SUM(factdailysalesreport[MTD_Volume])
			
			
			
			
