table FactDailySalesReport
	lineageTag: c94c8049-d0f9-404c-ac3e-3b8a59650c6c

	measure 'Previous Day Volume New' =
			
			VAR SelectedDate = SELECTEDVALUE(DimDate[Date])
			RETURN
			IF (
			    NOT ISBLANK(SelectedDate),
			    CALCULATE(
			        SUM(FactDailySalesReport[Day_Volume]),
			        FILTER(
			            ALL(DimDate),
			            DimDate[Date] = SelectedDate - 1
			        )
			    )
			)
		formatString: 0
		lineageTag: 2d6380fe-5511-4401-b58d-75187b7f3b89

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Previous Day Retail New' =
			
			VAR SelectedDate = SELECTEDVALUE(DimDate[Date])
			RETURN
			IF (
			    NOT ISBLANK(SelectedDate),
			    CALCULATE(
			        SUM(FactDailySalesReport[Day_Retail]),
			        FILTER(
			            ALL(DimDate),
			            DimDate[Date] = SelectedDate - 1
			        )
			    )
			)
		formatString: 0
		lineageTag: d14d9e86-c19f-4b60-9f63-f1276c2bd83f

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'DateVol_CurrentMonth_ExclToday New' = ```
			
			VAR TodayDate = TODAY()
			VAR FirstDayOfCurrentMonth = DATE(YEAR(TodayDate), MONTH(TodayDate), 1)
			VAR Yesterday = TodayDate - 1
			
			RETURN
			CALCULATE(
			    SUM(FactDailySalesReport[Day_Volume]),
			    DimDate[Date] >= FirstDayOfCurrentMonth &&
			    DimDate[Date] <= Yesterday
			)
			
			
			```
		lineageTag: 3fe19589-0b21-49cf-80a0-965e31861344

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'DateVol_PreviousMonth_ExclToday New' = ```
			
			VAR TodayDate = TODAY()
			VAR FirstDayOfCurrentMonth = DATE(YEAR(TodayDate), MONTH(TodayDate), 1)
			VAR LastDayOfPreviousMonth = FirstDayOfCurrentMonth - 1
			VAR FirstDayOfPreviousMonth = DATE(YEAR(LastDayOfPreviousMonth), MONTH(LastDayOfPreviousMonth), 1)
			
			RETURN
			CALCULATE(
			    SUM(FactDailySalesReport[Day_Volume]),
			    DimDate[Date] >= FirstDayOfPreviousMonth &&
			    DimDate[Date] <= LastDayOfPreviousMonth
			)
			
			```
		lineageTag: 81e96f0b-bb0e-48f6-b5ab-ef38f2d53d9b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'DateRetail_MTD_ExclToday New' = ```
			
			VAR TodayDate = TODAY()
			VAR FirstDayOfCurrentMonth = DATE(YEAR(TodayDate), MONTH(TodayDate), 1)
			VAR Yesterday = TodayDate - 1
			
			RETURN
			CALCULATE(
			    SUM(FactDailySalesReport[Day_Retail]),
			    DimDate[Date] >= FirstDayOfCurrentMonth &&
			    DimDate[Date] <= Yesterday
			)
			
			```
		lineageTag: 14cf8de1-b39c-4d95-a698-5de5702bf36c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'DateRetail_PreviousMonth_ExclToday New' =
			
			VAR TodayDate = TODAY()
			VAR FirstDayOfCurrentMonth = DATE(YEAR(TodayDate), MONTH(TodayDate), 1)
			VAR LastDayOfPreviousMonth = FirstDayOfCurrentMonth - 1
			VAR FirstDayOfPreviousMonth = DATE(YEAR(LastDayOfPreviousMonth), MONTH(LastDayOfPreviousMonth), 1)
			
			RETURN
			CALCULATE(
			    SUM(FactDailySalesReport[Day_Retail]),
			    DimDate[Date] >= FirstDayOfPreviousMonth &&
			    DimDate[Date] <= LastDayOfPreviousMonth
			)
		lineageTag: 510b03f1-46f6-4982-ae22-97ecb58933e8

