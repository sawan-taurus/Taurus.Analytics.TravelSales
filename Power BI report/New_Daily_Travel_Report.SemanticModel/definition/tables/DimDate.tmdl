	column SlicerDate =
			
			SWITCH(
			    TRUE(),
			    'DimDate'[Date] = TODAY(), "Today",
			    'DimDate'[Date] = TODAY() - 1, "Latest",
			    YEAR('DimDate'[Date]) & "/" &
			    RIGHT("0" & MONTH('DimDate'[Date]), 2) & "/" &
			    RIGHT("0" & DAY('DimDate'[Date]), 2)
			)
		lineageTag: 83cf943e-69bd-414d-9d5b-11d60cbdbcc5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

