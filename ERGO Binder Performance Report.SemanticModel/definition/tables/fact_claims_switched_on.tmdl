	/// Total Incurred excluding Large Losses, sourced from the claims table's own ex_large_losses column (which is already cumulative-to-date per Month tag), for policies within the UW Year cohort. Corrected from an earlier version that wrongly summed fact_master_bdx_switched_on[Ex Large Losses] instead of the claims-side figure.
	measure 'Total Incurred Ex LL (Cumulative)' =
			VAR CohortStart = [_CohortStart]
			VAR CohortEnd = [_CohortEnd]
			VAR SelMonth = COALESCE(SELECTEDVALUE(fact_master_bdx_switched_on[Month]), SELECTEDVALUE(fact_claims_switched_on[Month]))
			VAR SelKey = IF(NOT ISBLANK(SelMonth), YEAR(DATEVALUE("01-" & SelMonth)) * 100 + MONTH(DATEVALUE("01-" & SelMonth)))
			VAR QualifyingPolicies =
			    CALCULATETABLE(
			        VALUES(fact_master_bdx_switched_on[PolicyID]),
			        ALL(fact_master_bdx_switched_on[Month]),
			        fact_master_bdx_switched_on[IssueDate] >= CohortStart,
			        fact_master_bdx_switched_on[IssueDate] <= CohortEnd,
			        IF(ISBLANK(SelKey), TRUE(), fact_master_bdx_switched_on[MonthSortKey] <= SelKey)
			    )
			RETURN
			CALCULATE(
			    SUM(fact_claims_switched_on[ex_large_losses]),
			    ALL(fact_claims_switched_on[Month]),
			    TREATAS(QualifyingPolicies, fact_claims_switched_on[PolicyID]),
			    IF(ISBLANK(SelMonth), TRUE(), fact_claims_switched_on[Month] = SelMonth)
			)
		formatString: #,##0
		displayFolder: Cumulative (UW Year)
		lineageTag: 10d5848a-5b72-444e-a10c-15ec755d7487

	/// Average cost per claim, cumulative up to and including the selected Development Month = Total Incurred (Cumulative) / Claims Count (Cumulative). Corrected 2026-08-26 to match the formula used in SOI Performance Report and Viva Performance Report (previously held the Av Cost Per Open formula by mistake).
	measure 'Av Cost Per Claim' = IFERROR([Total Incurred (Cumulative)]/[Claims Count (Cumulative)], 0)
		formatString: #,##0.00
		displayFolder: Cumulative (UW Year)
		lineageTag: 848d0196-4a94-4ba4-bca7-7510f3b81fef

	/// Cumulative settled-claim count based on claim-level Status2 = Closed, for policies issued on or before the selected Development Month within the UW Year cohort.
	measure 'Settled Count' =
			VAR CohortStart = [_CohortStart]
			VAR CohortEnd = [_CohortEnd]
			VAR SelMonth = COALESCE(SELECTEDVALUE(fact_master_bdx_switched_on[Month]), SELECTEDVALUE(fact_claims_switched_on[Month]))
			VAR SelKey = IF(NOT ISBLANK(SelMonth), YEAR(DATEVALUE("01-" & SelMonth)) * 100 + MONTH(DATEVALUE("01-" & SelMonth)))
			VAR QualifyingPolicies =
			    CALCULATETABLE(
			        VALUES(fact_master_bdx_switched_on[PolicyID]),
			        ALL(fact_master_bdx_switched_on[Month]),
			        fact_master_bdx_switched_on[IssueDate] >= CohortStart,
			        fact_master_bdx_switched_on[IssueDate] <= CohortEnd,
			        IF(ISBLANK(SelKey), TRUE(), fact_master_bdx_switched_on[MonthSortKey] <= SelKey)
			    )
			RETURN
			CALCULATE(
			    COUNTROWS(fact_claims_switched_on),
			    ALL(fact_claims_switched_on[Month]),
			    fact_claims_switched_on[Status2] = "Closed",
			    TREATAS(QualifyingPolicies, fact_claims_switched_on[PolicyID]),
			    IF(ISBLANK(SelMonth), TRUE(), fact_claims_switched_on[Month] = SelMonth)
			)
		formatString: 0
		lineageTag: 829ca38b-1d0f-4d6a-8d37-1c4e687802c2

	/// Cumulative settled-claims incurred value based on claim-level Status2 = Closed, for policies issued on or before the selected Development Month within the UW Year cohort.
	measure 'Settled Incurred' =
			VAR CohortStart = [_CohortStart]
			VAR CohortEnd = [_CohortEnd]
			VAR SelMonth = COALESCE(SELECTEDVALUE(fact_master_bdx_switched_on[Month]), SELECTEDVALUE(fact_claims_switched_on[Month]))
			VAR SelKey = IF(NOT ISBLANK(SelMonth), YEAR(DATEVALUE("01-" & SelMonth)) * 100 + MONTH(DATEVALUE("01-" & SelMonth)))
			VAR QualifyingPolicies =
			    CALCULATETABLE(
			        VALUES(fact_master_bdx_switched_on[PolicyID]),
			        ALL(fact_master_bdx_switched_on[Month]),
			        fact_master_bdx_switched_on[IssueDate] >= CohortStart,
			        fact_master_bdx_switched_on[IssueDate] <= CohortEnd,
			        IF(ISBLANK(SelKey), TRUE(), fact_master_bdx_switched_on[MonthSortKey] <= SelKey)
			    )
			RETURN
			CALCULATE(
			    SUM(fact_claims_switched_on[Incurred]),
			    ALL(fact_claims_switched_on[Month]),
			    fact_claims_switched_on[Status2] = "Closed",
			    TREATAS(QualifyingPolicies, fact_claims_switched_on[PolicyID]),
			    IF(ISBLANK(SelMonth), TRUE(), fact_claims_switched_on[Month] = SelMonth)
			)
		formatString: #,##0
		lineageTag: 752d0e53-1caf-4f1c-9482-a04eb67b4462

	/// Average cost per settled claim = Settled Incurred / Settled Count, cumulative up to and including the selected Development Month.
	measure 'Av Cost Per Settled' = IFERROR([Settled Incurred]/[Settled Count], 0)
		formatString: 0.00
		displayFolder: Cumulative (UW Year)
		lineageTag: 832c1b97-89ed-4cee-a602-d0f8b956a59c

	/// Cumulative claim count where Status2 is neither Open nor Closed, for policies issued on or before the selected Development Month within the UW Year cohort.
	measure 'Other Count' =
			VAR CohortStart = [_CohortStart]
			VAR CohortEnd = [_CohortEnd]
			VAR SelMonth = COALESCE(SELECTEDVALUE(fact_master_bdx_switched_on[Month]), SELECTEDVALUE(fact_claims_switched_on[Month]))
			VAR SelKey = IF(NOT ISBLANK(SelMonth), YEAR(DATEVALUE("01-" & SelMonth)) * 100 + MONTH(DATEVALUE("01-" & SelMonth)))
			VAR QualifyingPolicies =
			    CALCULATETABLE(
			        VALUES(fact_master_bdx_switched_on[PolicyID]),
			        ALL(fact_master_bdx_switched_on[Month]),
			        fact_master_bdx_switched_on[IssueDate] >= CohortStart,
			        fact_master_bdx_switched_on[IssueDate] <= CohortEnd,
			        IF(ISBLANK(SelKey), TRUE(), fact_master_bdx_switched_on[MonthSortKey] <= SelKey)
			    )
			RETURN
			CALCULATE(
			    COUNTROWS(fact_claims_switched_on),
			    ALL(fact_claims_switched_on[Month]),
			    fact_claims_switched_on[Status2] <> "Open",
			    fact_claims_switched_on[Status2] <> "Closed",
			    TREATAS(QualifyingPolicies, fact_claims_switched_on[PolicyID]),
			    IF(ISBLANK(SelMonth), TRUE(), fact_claims_switched_on[Month] = SelMonth)
			)
		formatString: 0
		lineageTag: 6c540cdb-efdf-4b46-93d0-b8b1516b9243

	/// Cumulative incurred value where Status2 is neither Open nor Closed, for policies issued on or before the selected Development Month within the UW Year cohort.
	measure 'Other Incurred' =
			VAR CohortStart = [_CohortStart]
			VAR CohortEnd = [_CohortEnd]
			VAR SelMonth = COALESCE(SELECTEDVALUE(fact_master_bdx_switched_on[Month]), SELECTEDVALUE(fact_claims_switched_on[Month]))
			VAR SelKey = IF(NOT ISBLANK(SelMonth), YEAR(DATEVALUE("01-" & SelMonth)) * 100 + MONTH(DATEVALUE("01-" & SelMonth)))
			VAR QualifyingPolicies =
			    CALCULATETABLE(
			        VALUES(fact_master_bdx_switched_on[PolicyID]),
			        ALL(fact_master_bdx_switched_on[Month]),
			        fact_master_bdx_switched_on[IssueDate] >= CohortStart,
			        fact_master_bdx_switched_on[IssueDate] <= CohortEnd,
			        IF(ISBLANK(SelKey), TRUE(), fact_master_bdx_switched_on[MonthSortKey] <= SelKey)
			    )
			RETURN
			CALCULATE(
			    SUM(fact_claims_switched_on[Incurred]),
			    ALL(fact_claims_switched_on[Month]),
			    fact_claims_switched_on[Status2] <> "Open",
			    fact_claims_switched_on[Status2] <> "Closed",
			    TREATAS(QualifyingPolicies, fact_claims_switched_on[PolicyID]),
			    IF(ISBLANK(SelMonth), TRUE(), fact_claims_switched_on[Month] = SelMonth)
			)
		formatString: #,##0
		lineageTag: 93f96329-1513-42c2-9e91-82f51536572c

	/// Average cost per claim where Status2 is neither Open nor Closed = Other Status Incurred / Other Status Count, cumulative up to and including the selected Development Month.
	measure 'Av Cost Per Other' = IFERROR([Other Incurred]/[Other Count], 0)
		formatString: 0.00
		displayFolder: Cumulative (UW Year)
		lineageTag: 8e520a6e-3371-4739-8ab8-9d539c676c53

	/// Average cost per open claim = Open Incurred Claims / Open Claims Count, using DIVIDE with a 0 fallback to avoid divide-by-zero errors. Corrected 2026-08-26: previously referenced a non-existent physical column and errored.
	measure 'Av Cost Per Open' =
			DIVIDE(
			    [Open Incurred Claims],
			    [Open Claims Count],
			    0
			)
		formatString: #,##0.00
		displayFolder: Cumulative (UW Year)
		lineageTag: beaeeeaa-85e6-4a57-8b40-230bfaa3eede

