	/// Correct open-claim count based on claim-level Status2, for policies issued on or before the selected Development Month within the UW Year cohort. Claims data is now cumulative-to-date per Month tag, so the claim set is filtered by direct Month equality instead of a DTNotify cutoff.
	measure 'Open Claims Count' =
			VAR CohortStart = [_CohortStart]
			VAR CohortEnd = [_CohortEnd]
			VAR SelMonth = COALESCE(SELECTEDVALUE(fact_master_bdx_switched_on[Month]), SELECTEDVALUE(fact_claims_switched_on[Month]))
			VAR SelKey = IF(NOT ISBLANK(SelMonth), YEAR(DATEVALUE("01-" & SelMonth)) * 100 + MONTH(DATEVALUE("01-" & SelMonth)))
			VAR QualifyingPolicies =
			    CALCULATETABLE(
			        VALUES(fact_master_bdx_switched_on[PolicyID]),
			        ALL(fact_master_bdx_switched_on[Month]),
			        fact_master_bdx_switched_on[IssueDate] >= CohortStart,
			        fact_master_bdx_switched_on[IssueDate] <= CohortEnd,
			        IF(ISBLANK(SelKey), TRUE(), fact_master_bdx_switched_on[MonthSortKey] <= SelKey)
			    )
			RETURN
			CALCULATE(
			    COUNTROWS(fact_claims_switched_on),
			    ALL(fact_claims_switched_on[Month]),
			    fact_claims_switched_on[Status2] = "Open",
			    TREATAS(QualifyingPolicies, fact_claims_switched_on[PolicyID]),
			    IF(ISBLANK(SelMonth), TRUE(), fact_claims_switched_on[Month] = SelMonth)
			)
		formatString: 0
		lineageTag: 6efa6870-64e5-49dd-8dff-a97d30120470

	/// Correct open-claims incurred value based on claim-level Status2, for policies issued on or before the selected Development Month within the UW Year cohort. Claims data is now cumulative-to-date per Month tag, so the claim set is filtered by direct Month equality instead of a DTNotify cutoff.
	measure 'Open Incurred Claims' =
			VAR CohortStart = [_CohortStart]
			VAR CohortEnd = [_CohortEnd]
			VAR SelMonth = COALESCE(SELECTEDVALUE(fact_master_bdx_switched_on[Month]), SELECTEDVALUE(fact_claims_switched_on[Month]))
			VAR SelKey = IF(NOT ISBLANK(SelMonth), YEAR(DATEVALUE("01-" & SelMonth)) * 100 + MONTH(DATEVALUE("01-" & SelMonth)))
			VAR QualifyingPolicies =
			    CALCULATETABLE(
			        VALUES(fact_master_bdx_switched_on[PolicyID]),
			        ALL(fact_master_bdx_switched_on[Month]),
			        fact_master_bdx_switched_on[IssueDate] >= CohortStart,
			        fact_master_bdx_switched_on[IssueDate] <= CohortEnd,
			        IF(ISBLANK(SelKey), TRUE(), fact_master_bdx_switched_on[MonthSortKey] <= SelKey)
			    )
			RETURN
			CALCULATE(
			    SUM(fact_claims_switched_on[Incurred]),
			    ALL(fact_claims_switched_on[Month]),
			    fact_claims_switched_on[Status2] = "Open",
			    TREATAS(QualifyingPolicies, fact_claims_switched_on[PolicyID]),
			    IF(ISBLANK(SelMonth), TRUE(), fact_claims_switched_on[Month] = SelMonth)
			)
		formatString: #,##0
		lineageTag: aa9313cf-9e13-4918-b983-b77d09eff624

	/// Total Incurred for claims linked to policies incepted in the UW year window AND issued on or before the selected Development Month (via MonthSortKey). Claims data is now cumulative-to-date per Month tag, so the claim set is filtered by direct Month equality instead of a DTNotify cutoff.
	measure 'Total Incurred (Cumulative)' =
			VAR CohortStart = [_CohortStart]
			VAR CohortEnd = [_CohortEnd]
			VAR SelMonth = COALESCE(SELECTEDVALUE(fact_master_bdx_switched_on[Month]), SELECTEDVALUE(fact_claims_switched_on[Month]))
			VAR SelKey = IF(NOT ISBLANK(SelMonth), YEAR(DATEVALUE("01-" & SelMonth)) * 100 + MONTH(DATEVALUE("01-" & SelMonth)))
			VAR QualifyingPolicies =
			    CALCULATETABLE(
			        VALUES(fact_master_bdx_switched_on[PolicyID]),
			        ALL(fact_master_bdx_switched_on[Month]),
			        fact_master_bdx_switched_on[IssueDate] >= CohortStart,
			        fact_master_bdx_switched_on[IssueDate] <= CohortEnd,
			        IF(ISBLANK(SelKey), TRUE(), fact_master_bdx_switched_on[MonthSortKey] <= SelKey)
			    )
			RETURN
			CALCULATE(
			    SUM(fact_claims_switched_on[Incurred]),
			    ALL(fact_claims_switched_on[Month]),
			    TREATAS(QualifyingPolicies, fact_claims_switched_on[PolicyID]),
			    IF(ISBLANK(SelMonth), TRUE(), fact_claims_switched_on[Month] = SelMonth)
			)
		formatString: #,##0
		displayFolder: Cumulative (UW Year)
		lineageTag: 572020d7-4a80-4877-8c46-533a20f53b11

	/// Claims count for claims linked to policies incepted in the UW year window AND issued on or before the selected Development Month (via MonthSortKey). Claims data is now cumulative-to-date per Month tag, so the claim set is filtered by direct Month equality instead of a DTNotify cutoff.
