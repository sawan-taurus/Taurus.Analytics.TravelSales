table fact_claims_switched_on
	lineageTag: bab6931a-842d-457d-89ef-321f2e46d408

	/// Cumulative count: claims with Status2 = Declined whose own Month is on or before the selected Development Month (falls back to all-time count if none selected).
	measure 'Declined Count' =
			VAR SelMonth = COALESCE(SELECTEDVALUE(fact_claims_switched_on[Month]), SELECTEDVALUE(fact_master_bdx_switched_on[Month]))
			RETURN
			IF(
			    ISBLANK(SelMonth),
			    CALCULATE(COUNTROWS(fact_claims_switched_on), fact_claims_switched_on[Status2] = "Declined"),
			    CALCULATE(
			        COUNTROWS(fact_claims_switched_on),
			        fact_claims_switched_on[Status2] = "Declined",
			        ALL(fact_claims_switched_on[Month]),
			        fact_claims_switched_on[Month] = SelMonth
			    )
			)
		formatString: 0
		lineageTag: fb585d70-b1a9-4aa4-846d-16bbb332a4a3

	/// Declined Count / Claims Count (Cumulative), both cumulative up to and including the selected Development Month. Replaces the old denominator, which summed the raw single-month fact_master_bdx_switched_on[ClaimCount] column.
	measure '% Declined' =
			IF(
			    [Declined Count] = 0,
			    0,
			    DIVIDE([Declined Count], [Claims Count (Cumulative)], 0)
			)
		formatString: 0%;-0%;0%
		lineageTag: 401d84f5-5b69-48b6-9caa-510b2155f593

