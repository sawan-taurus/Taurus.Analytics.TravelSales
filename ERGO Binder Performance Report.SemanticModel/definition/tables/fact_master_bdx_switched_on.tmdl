			VAR DenomLeaf = CALCULATE([Total Policies (Cumulative)], REMOVEFILTERS('fact_master_bdx_switched_on'[Dur Band]))
			VAR DenomPolicy2 = CALCULATE([Total Policies (Cumulative)], REMOVEFILTERS('fact_master_bdx_switched_on'[Policy2]), REMOVEFILTERS('DimPolicy2'[Policy3]), REMOVEFILTERS('fact_master_bdx_switched_on'[Dur Band]))
			VAR DenomChannel = CALCULATE([Total Policies (Cumulative)], REMOVEFILTERS('fact_master_bdx_switched_on'[Channel]), REMOVEFILTERS('fact_master_bdx_switched_on'[Policy2]), REMOVEFILTERS('DimPolicy2'[Policy3]), REMOVEFILTERS('fact_master_bdx_switched_on'[Dur Band]))
			RETURN
			DIVIDE(
			    CurrentPolicies,
			    SWITCH(
			        TRUE(),
			        ISINSCOPE('fact_master_bdx_switched_on'[Dur Band]), DenomLeaf,
			        ISINSCOPE('fact_master_bdx_switched_on'[Policy2]) || ISINSCOPE('DimPolicy2'[Policy3]), DenomPolicy2,
			        ISINSCOPE('fact_master_bdx_switched_on'[Channel]), DenomChannel,
			        DenomLeaf
			    )
			)
		formatString: 0%;-0%;0%
		lineageTag: a3901589-aa6e-44f6-a3a9-7191968e1ede

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Total RetailDurBand' =
			
			VAR CurrentRetail = [Total Retail (Cumulative)]
			VAR DenomLeaf = CALCULATE([Total Retail (Cumulative)], REMOVEFILTERS('fact_master_bdx_switched_on'[Dur Band]))
			VAR DenomPolicy2 = CALCULATE([Total Retail (Cumulative)], REMOVEFILTERS('fact_master_bdx_switched_on'[Policy2]), REMOVEFILTERS('DimPolicy2'[Policy3]), REMOVEFILTERS('fact_master_bdx_switched_on'[Dur Band]))
			VAR DenomChannel = CALCULATE([Total Retail (Cumulative)], REMOVEFILTERS('fact_master_bdx_switched_on'[Channel]), REMOVEFILTERS('fact_master_bdx_switched_on'[Policy2]), REMOVEFILTERS('DimPolicy2'[Policy3]), REMOVEFILTERS('fact_master_bdx_switched_on'[Dur Band]))
			RETURN
			DIVIDE(
			    CurrentRetail,
			    SWITCH(
			        TRUE(),
			        ISINSCOPE('fact_master_bdx_switched_on'[Dur Band]), DenomLeaf,
			        ISINSCOPE('fact_master_bdx_switched_on'[Policy2]) || ISINSCOPE('DimPolicy2'[Policy3]), DenomPolicy2,
			        ISINSCOPE('fact_master_bdx_switched_on'[Channel]), DenomChannel,
			        DenomLeaf
			    )
			)
		formatString: 0%;-0%;0%
		lineageTag: 50996983-f548-434d-8923-3e76d255539b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Earned' =
			
			DIVIDE(
			    SUM('fact_master_bdx_switched_on'[Earned NWP]),
			    SUM('fact_master_bdx_switched_on'[Total NWP]),
			    0
			)
		formatString: 0%;-0%;0%
		lineageTag: 6eca8ad0-65cd-47fb-868f-f4e5c57c533b

	/// Policies (Cumulative) x % Earned (Cumulative) per Policy3 category (AMT/Single Trip/BP), summed — matches Rowan's Excel formula so the Total column equals the sum of the category columns. Updated to use the Cumulative variants of both Policies and % Earned, consistent with the rest of the Development Month cumulative logic.
	measure 'Policies Earned' =
			SUMX(
			    VALUES(DimPolicy2[Policy3]),
			    CALCULATE([Policies (Cumulative)]) * CALCULATE([% Earned (Cumulative)])
			)
		formatString: #,##0
		lineageTag: 8bc47c26-6e16-4b76-a48d-85db3435a0e2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'New Total GWP ex' = ```
			
			SUMX(
			    'fact_master_bdx_switched_on',
			    'fact_master_bdx_switched_on'[ERV BaseGrossExc] 
			    + 'fact_master_bdx_switched_on'[ERV OptionGrossExc] 
			    + 'fact_master_bdx_switched_on'[ERV MedicalGrossExc]
			)
			```
		lineageTag: bb10aa6c-95e3-4413-8329-a86c51075778

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg GWP New' =
			
			DIVIDE(
			    [New Total GWP ex],
			    SUM([Policy]),
			    0
			)
		lineageTag: b28e10c8-160f-42d1-955c-53106d183154

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Incident Rate' =
			DIVIDE(
			    [Claims Count (Cumulative)],
			    [Policies Earned],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 220c95b9-9122-4a3c-b34e-485a3e4c7a96

	/// Net policy count = SUM of (+1 for PolicyStatus in Active/Endorsed/Renewal, -1 otherwise), cumulative up to and including the selected Development Month (via MonthSortKey, avoiding the time-of-day truncation bug that the old IssueDate<=cutoff date comparison had), within the UW Year cohort window. Verified: Jan-26 = 9,838.
	measure 'Policies (Cumulative)' =
			VAR CohortStart = [_CohortStart]
			VAR CohortEnd = [_CohortEnd]
			VAR SelMonth = COALESCE(SELECTEDVALUE(fact_master_bdx_switched_on[Month]), SELECTEDVALUE(fact_claims_switched_on[Month]))
			VAR SelKey = IF(NOT ISBLANK(SelMonth), YEAR(DATEVALUE("01-" & SelMonth)) * 100 + MONTH(DATEVALUE("01-" & SelMonth)))
			RETURN
			CALCULATE(
			    SUMX(
			        fact_master_bdx_switched_on,
			        IF(fact_master_bdx_switched_on[PolicyStatus] IN {"Active", "Endorsed", "Renewal"}, 1, -1)
			    ),
			    ALL(fact_master_bdx_switched_on[Month]),
			    fact_master_bdx_switched_on[IssueDate] >= CohortStart,
			    fact_master_bdx_switched_on[IssueDate] <= CohortEnd,
			    IF(ISBLANK(SelKey), TRUE(), fact_master_bdx_switched_on[MonthSortKey] <= SelKey)
			)
		formatString: #,##0
		displayFolder: Cumulative (UW Year)
		lineageTag: d17c9298-b25b-4e75-a57c-4329c93fe6cd

	/// As-at/cutoff date driven by the Development Month filter, whichever table's Month field the slicer actually filters (fact_master_bdx_switched_on[Month] or fact_claims_switched_on[Month]). Defaults to a far-future date (no restriction) if nothing selected.
	measure _DevelopmentAsAtDate =
			VAR SelMonth = COALESCE(SELECTEDVALUE(fact_master_bdx_switched_on[Month]), SELECTEDVALUE(fact_claims_switched_on[Month]))
			RETURN
			IF(
			    ISBLANK(SelMonth),
			    DATE(9999,12,31),
			    EOMONTH(DATEVALUE("01-" & SelMonth), 0)
			)
		isHidden
		lineageTag: 59b8569e-6271-4f22-a108-4a0f3d165ffb

	/// Cumulative GWP (ex IPT), base field ERV TotalGrossExc, for policies incepted within the UW Year cohort, cumulative up to and including the selected Development Month (via MonthSortKey, avoiding the time-of-day truncation bug the old IssueDate<=cutoff-date comparison had).
	measure 'GWP (Cumulative)' =
			VAR CohortStart = [_CohortStart]
			VAR CohortEnd = [_CohortEnd]
			VAR SelMonth = COALESCE(SELECTEDVALUE(fact_master_bdx_switched_on[Month]), SELECTEDVALUE(fact_claims_switched_on[Month]))
			VAR SelKey = IF(NOT ISBLANK(SelMonth), YEAR(DATEVALUE("01-" & SelMonth)) * 100 + MONTH(DATEVALUE("01-" & SelMonth)))
			RETURN
			CALCULATE(
			    SUM(fact_master_bdx_switched_on[ERV TotalGrossExc]),
			    ALL(fact_master_bdx_switched_on[Month]),
			    fact_master_bdx_switched_on[IssueDate] >= CohortStart,
			    fact_master_bdx_switched_on[IssueDate] <= CohortEnd,
			    IF(ISBLANK(SelKey), TRUE(), fact_master_bdx_switched_on[MonthSortKey] <= SelKey)
			)
		formatString: #,##0
		lineageTag: 719c9c0b-7033-44ff-9740-bbdf531d2e6e

	/// Cumulative NWP, base field ERV TotalNetToUw, for policies incepted within the UW Year cohort, cumulative up to and including the selected Development Month (via MonthSortKey, avoiding the time-of-day truncation bug the old IssueDate<=cutoff-date comparison had).
	measure 'NWP (Cumulative)' =
			VAR CohortStart = [_CohortStart]
			VAR CohortEnd = [_CohortEnd]
			VAR SelMonth = COALESCE(SELECTEDVALUE(fact_master_bdx_switched_on[Month]), SELECTEDVALUE(fact_claims_switched_on[Month]))
			VAR SelKey = IF(NOT ISBLANK(SelMonth), YEAR(DATEVALUE("01-" & SelMonth)) * 100 + MONTH(DATEVALUE("01-" & SelMonth)))
			RETURN
			CALCULATE(
			    SUM(fact_master_bdx_switched_on[ERV TotalNetToUw]),
			    ALL(fact_master_bdx_switched_on[Month]),
			    fact_master_bdx_switched_on[IssueDate] >= CohortStart,
			    fact_master_bdx_switched_on[IssueDate] <= CohortEnd,
			    IF(ISBLANK(SelKey), TRUE(), fact_master_bdx_switched_on[MonthSortKey] <= SelKey)
			)
		formatString: #,##0
		lineageTag: df01e04f-31d8-4ef3-ad9b-122d3be55107

	/// Cumulative NEP, base field Earned NWP for the current Development Month row, and (Earning % x ERV TotalNetToUw) for prior-month rows recalculated to the selected cutoff — for policies incepted within the UW Year cohort. FIXED 2026-08-26: the prior-month recalculation previously multiplied the earning % by fact_master_bdx_switched_on[Total NWP], a larger premium figure than the ERV TotalNetToUw basis used by [NWP (Cumulative)]; for Single Trip/AMT policies (where Total NWP can run 17%-95% higher than ERV TotalNetToUw) this pushed % Earned (Cumulative) above 100%, which in turn made [Policies Earned] exceed [Policies (Cumulative)] (reported for ERGO Binder AGGS/Single Trip). RTotalNWP now sources ERV TotalNetToUw so NEP and NWP share the same premium basis.
	measure 'NEP (Cumulative)' =
			VAR CohortStart = [_CohortStart]
			VAR CohortEnd = [_CohortEnd]
			VAR SelMonth = COALESCE(SELECTEDVALUE(fact_master_bdx_switched_on[Month]), SELECTEDVALUE(fact_claims_switched_on[Month]))
			VAR SelKey = IF(NOT ISBLANK(SelMonth), YEAR(DATEVALUE("01-" & SelMonth)) * 100 + MONTH(DATEVALUE("01-" & SelMonth)))
			VAR SelCutoff = IF(NOT ISBLANK(SelMonth), EOMONTH(DATEVALUE("01-" & SelMonth), 0))
			VAR LtPatternNorm =
			    ADDCOLUMNS(
			        ALL(LeadTimeEarningPattern),
			        "NormCh", IF(UPPER(TRIM(LeadTimeEarningPattern[Channel])) IN {"AGG","AGGS"}, "AGGS", UPPER(TRIM(LeadTimeEarningPattern[Channel])))
			    )
			VAR DurPatternNorm =
			    ADDCOLUMNS(
			        ALL(DurationEarningPattern),
			        "NormCh", IF(UPPER(TRIM(DurationEarningPattern[Channel])) IN {"AGG","AGGS"}, "AGGS", UPPER(TRIM(DurationEarningPattern[Channel])))
			    )
			VAR OverallPatternNorm =
			    ADDCOLUMNS(
			        ALL(OverallEarningPattern),
			        "NormCh", IF(UPPER(TRIM(OverallEarningPattern[Channel])) IN {"AGG","AGGS"}, "AGGS", UPPER(TRIM(OverallEarningPattern[Channel])))
			    )
			VAR AmtPatternNorm =
			    ADDCOLUMNS(
			        ALL(AmtEarningPattern),
			        "IsDirect", UPPER(TRIM(AmtEarningPattern[Channel])) = "DIRECT"
			    )
			VAR MasterRows =
			    CALCULATETABLE(
			        SELECTCOLUMNS(
			            fact_master_bdx_switched_on,
			            "RMonth", fact_master_bdx_switched_on[Month],
			            "RPolicyID", fact_master_bdx_switched_on[PolicyID],
			            "RChannel", fact_master_bdx_switched_on[Channel],
			            "RIssueDate", fact_master_bdx_switched_on[IssueDate],
			            "RStart", fact_master_bdx_switched_on[Start],
			            "REnd", fact_master_bdx_switched_on[End],
			            "RLeadTimeBanding", fact_master_bdx_switched_on[Lead Time Banding],
			            "RInitialPolicy", fact_master_bdx_switched_on[initial_policy],
			            "RTotalNWP", fact_master_bdx_switched_on[ERV TotalNetToUw],
			            "RPolicy", fact_master_bdx_switched_on[Policy],
			            "RStoredEarnedNWP", fact_master_bdx_switched_on[Earned NWP]
			        ),
			        ALL(fact_master_bdx_switched_on[Month]),
			        fact_master_bdx_switched_on[IssueDate] >= CohortStart,
			        fact_master_bdx_switched_on[IssueDate] <= CohortEnd,
			        IF(ISBLANK(SelKey), TRUE(), fact_master_bdx_switched_on[MonthSortKey] <= SelKey)
			    )
			RETURN
			IF(
			    ISBLANK(SelCutoff),
			    SUMX(MasterRows, [RStoredEarnedNWP]),
			    SUMX(
			        MasterRows,
			        VAR RowMonth = [RMonth]
			        VAR RowPolicyID = [RPolicyID]
			        RETURN
			        IF(
			            RowMonth = SelMonth,
			            [RStoredEarnedNWP],
			            VAR RowChannelU = UPPER(TRIM([RChannel]))
			            VAR NormChannel = IF(RowChannelU IN {"AGG","AGGS"}, "AGGS", RowChannelU)
			            VAR IssueDt = [RIssueDate]
			            VAR StartDt = [RStart]
			            VAR EndDt = [REnd]
			            VAR DenomLTR = DATEDIFF(IssueDt, StartDt, DAY)
			            VAR LTR_new =
			                IF(
			                    SelCutoff >= StartDt,
			                    1.0,
			                    IF(OR(DenomLTR = 0, ISBLANK(DenomLTR)), BLANK(), DATEDIFF(IssueDt, SelCutoff, DAY) / DenomLTR)
			                )
			            VAR DenomDR = DATEDIFF(StartDt, EndDt, DAY) + 1
			            VAR DR_new =
			                IF(
			                    LTR_new < 1, 0,
			                    IF(
			                        SelCutoff > EndDt, 1,
			                        IF(OR(DenomDR = 0, ISBLANK(DenomDR)), BLANK(), DATEDIFF(StartDt, SelCutoff, DAY) / DenomDR)
			                    )
			                )
			            VAR LTR_UB_new = MIN(1, MAX(0.05, ROUNDUP(LTR_new * 20, 0) / 20))
			            VAR DR_UB_new = MIN(1, MAX(0.05, ROUNDUP(DR_new * 20, 0) / 20))
			            VAR LtBand = [RLeadTimeBanding]
			            VAR LtMatches =
			                FILTER(
			                    LtPatternNorm,
			                    [NormCh] = NormChannel && LeadTimeEarningPattern[LeadTimeBanding] = LtBand && LeadTimeEarningPattern[UB] <= LTR_UB_new
			                )
			            VAR MatchedLtUb = MAXX(LtMatches, LeadTimeEarningPattern[UB])
			            VAR LtPctValue =
			                MAXX(
			                    FILTER(LtMatches, LeadTimeEarningPattern[UB] = MatchedLtUb),
			                    LeadTimeEarningPattern[PctValue]
			                )
			            VAR EP_LT_new = IF(LTR_new <= 0, 0, COALESCE(LtPctValue, 0))
			            VAR DurMatches =
			                FILTER(
			                    DurPatternNorm,
			                    [NormCh] = NormChannel && ROUND(DurationEarningPattern[UB], 4) = ROUND(DR_UB_new, 4)
			                )
			            VAR DurPctValue = MAXX(DurMatches, DurationEarningPattern[EarningPctValue])
			            VAR EP_D_new = IF(DR_new <= 0, 0, COALESCE(DurPctValue, 0))
			            VAR OverallMatches =
			                FILTER(
			                    OverallPatternNorm,
			                    [NormCh] = NormChannel && OverallEarningPattern[LeadTimeBanding] = LtBand
			                )
			            VAR LtEpNumeric = COALESCE(MAXX(OverallMatches, OverallEarningPattern[LeadTimeEpValue]), 0)
			            VAR DurEpNumeric = COALESCE(MAXX(OverallMatches, OverallEarningPattern[DurationEpValue]), 0)
			            VAR EP_ST_new = EP_LT_new * LtEpNumeric + EP_D_new * DurEpNumeric
			            VAR AmtEpPeriod_new = MIN(366, MAX(1, DATEDIFF(StartDt, SelCutoff, DAY)))
			            VAR AmtMatches =
			                FILTER(
			                    AmtPatternNorm,
			                    IF(NormChannel = "DIRECT", [IsDirect], NOT [IsDirect])
			                        && AmtEarningPattern[DevelopmentDays] = AmtEpPeriod_new
			                )
			            VAR AmtEpValue = MAXX(AmtMatches, AmtEarningPattern[EpValue])
			            VAR EP_AMT_new = COALESCE(AmtEpValue, 0)
			            VAR EarnedSales_new = IF([RInitialPolicy] = "AMT", EP_AMT_new, EP_ST_new)
			            VAR PolicyPolicySum =
			                CALCULATE(
			                    SUM(fact_master_bdx_switched_on[Policy]),
			                    ALL(fact_master_bdx_switched_on),
			                    fact_master_bdx_switched_on[PolicyID] = RowPolicyID,
			                    fact_master_bdx_switched_on[Month] = RowMonth
			                )
			            VAR EarnedNWP_new = IF(PolicyPolicySum = 0, [RTotalNWP], EarnedSales_new * [RTotalNWP])
			            RETURN
			                EarnedNWP_new
			        )
			    )
			)
		formatString: #,##0
		lineageTag: 5efbe15a-9a3a-455a-b684-824344778ddd

	/// Cumulative average GWP per policy, built the same way as [Avg GWP New] (ERV BaseGrossExc + ERV OptionGrossExc + ERV MedicalGrossExc, i.e. New Total GWP ex, divided by SUM(Policy)) but accumulated up to and including the selected Development Month via MonthSortKey (avoids the time-of-day truncation bug), within the UW Year cohort.
	measure 'Avg GWP (Cumulative)' =
			VAR CohortStart = [_CohortStart]
			VAR CohortEnd = [_CohortEnd]
			VAR SelMonth = COALESCE(SELECTEDVALUE(fact_master_bdx_switched_on[Month]), SELECTEDVALUE(fact_claims_switched_on[Month]))
			VAR SelKey = IF(NOT ISBLANK(SelMonth), YEAR(DATEVALUE("01-" & SelMonth)) * 100 + MONTH(DATEVALUE("01-" & SelMonth)))
			VAR CumNewGWP =
			    CALCULATE(
			        SUMX(fact_master_bdx_switched_on, fact_master_bdx_switched_on[ERV BaseGrossExc] + fact_master_bdx_switched_on[ERV OptionGrossExc] + fact_master_bdx_switched_on[ERV MedicalGrossExc]),
			        ALL(fact_master_bdx_switched_on[Month]),
			        fact_master_bdx_switched_on[IssueDate] >= CohortStart,
			        fact_master_bdx_switched_on[IssueDate] <= CohortEnd,
			        IF(ISBLANK(SelKey), TRUE(), fact_master_bdx_switched_on[MonthSortKey] <= SelKey)
			    )
			VAR CumPolicy =
			    CALCULATE(
			        SUM(fact_master_bdx_switched_on[Policy]),
			        ALL(fact_master_bdx_switched_on[Month]),
			        fact_master_bdx_switched_on[IssueDate] >= CohortStart,
			        fact_master_bdx_switched_on[IssueDate] <= CohortEnd,
			        IF(ISBLANK(SelKey), TRUE(), fact_master_bdx_switched_on[MonthSortKey] <= SelKey)
			    )
			RETURN
			DIVIDE(CumNewGWP, CumPolicy, 0)
		formatString: 0.00
		lineageTag: 66cd7800-c373-47fa-92df-ae0069c9195b

	/// Cumulative % Earned = NEP / NWP.
	measure '% Earned (Cumulative)' = DIVIDE([NEP (Cumulative)], [NWP (Cumulative)])
		formatString: 0%
		lineageTag: 49be8a82-9c56-4327-b247-7121abb35483

	/// Cumulative Net Earned Loss Ratio = Total Incurred (Cumulative) / NEP (Cumulative), up to and including the selected Development Month. Corrected from an earlier version that wrongly divided by [Incurred (Cumulative)] (a stale fact_master_bdx_switched_on-based figure) instead of the claims-based [Total Incurred (Cumulative)].
	measure 'NELR (Cumulative)' = DIVIDE([Total Incurred (Cumulative)], [NEP (Cumulative)], 0)
		formatString: 0%;-0%;0%
		displayFolder: Cumulative (UW Year)
		lineageTag: d83f1adb-7c0d-42f0-8bbe-deeef8e91d1b

	/// Cumulative Net Earned Loss Ratio excluding large losses = Total Incurred Ex LL (Cumulative) / NEP (Cumulative), up to and including the selected Development Month, within the UW Year cohort.
	measure 'NELR Ex LL (Cumulative)' = DIVIDE([Total Incurred Ex LL (Cumulative)], [NEP (Cumulative)], 0)
		formatString: 0%;-0%;0%
		displayFolder: Cumulative (UW Year)
		lineageTag: fc5a668b-4240-47ff-b4ca-2b792b101003

	/// Cumulative Incurred (fact_master_bdx_switched_on[Incurred]), for policies incepted within the UW Year cohort, cumulative up to and including the selected Development Month via MonthSortKey. Note: named without 'Total' prefix to avoid clashing with the existing claims-table measure 'Total Incurred (Cumulative)', which uses a different base (claims-level Incurred, joined via policy cohort + DTNotify cutoff).
	measure 'Incurred (Cumulative)' =
			VAR CohortStart = [_CohortStart]
			VAR CohortEnd = [_CohortEnd]
			VAR SelMonth = COALESCE(SELECTEDVALUE(fact_master_bdx_switched_on[Month]), SELECTEDVALUE(fact_claims_switched_on[Month]))
			VAR SelKey = IF(NOT ISBLANK(SelMonth), YEAR(DATEVALUE("01-" & SelMonth)) * 100 + MONTH(DATEVALUE("01-" & SelMonth)))
			RETURN
			CALCULATE(
			    SUM(fact_master_bdx_switched_on[Incurred]),
			    ALL(fact_master_bdx_switched_on[Month]),
			    fact_master_bdx_switched_on[IssueDate] >= CohortStart,
			    fact_master_bdx_switched_on[IssueDate] <= CohortEnd,
			    IF(ISBLANK(SelKey), TRUE(), fact_master_bdx_switched_on[MonthSortKey] <= SelKey)
			)
		formatString: #,##0
		displayFolder: Cumulative (UW Year)
		lineageTag: 61e48898-ba71-44e0-9341-02bf53ebfe1d

	/// Cumulative Total Policies, base field TotalPolicies (already 0 for Cancelled), for policies incepted within the UW Year cohort, cumulative up to and including the selected Development Month (via MonthSortKey, same pattern as NWP (Cumulative)/GWP (Cumulative)).
	measure 'Total Policies (Cumulative)' =
			VAR CohortStart = [_CohortStart]
			VAR CohortEnd = [_CohortEnd]
			VAR SelMonth = COALESCE(SELECTEDVALUE(fact_master_bdx_switched_on[Month]), SELECTEDVALUE(fact_claims_switched_on[Month]))
			VAR SelKey = IF(NOT ISBLANK(SelMonth), YEAR(DATEVALUE("01-" & SelMonth)) * 100 + MONTH(DATEVALUE("01-" & SelMonth)))
			RETURN
			CALCULATE(
			    SUM(fact_master_bdx_switched_on[TotalPolicies]),
			    ALL(fact_master_bdx_switched_on[Month]),
			    fact_master_bdx_switched_on[IssueDate] >= CohortStart,
			    fact_master_bdx_switched_on[IssueDate] <= CohortEnd,
			    IF(ISBLANK(SelKey), TRUE(), fact_master_bdx_switched_on[MonthSortKey] <= SelKey)
			)
		formatString: #,##0
		displayFolder: Cumulative (UW Year)
		lineageTag: 0808b079-ac4e-4f49-bf94-055890fb4936

	/// Cumulative Total Retail, base field TotalRetail (0 when TotalPolicies=0, else Combined TotalGross), for policies incepted within the UW Year cohort, cumulative up to and including the selected Development Month (via MonthSortKey, same pattern as NWP (Cumulative)/GWP (Cumulative)).
	measure 'Total Retail (Cumulative)' =
			VAR CohortStart = [_CohortStart]
			VAR CohortEnd = [_CohortEnd]
			VAR SelMonth = COALESCE(SELECTEDVALUE(fact_master_bdx_switched_on[Month]), SELECTEDVALUE(fact_claims_switched_on[Month]))
			VAR SelKey = IF(NOT ISBLANK(SelMonth), YEAR(DATEVALUE("01-" & SelMonth)) * 100 + MONTH(DATEVALUE("01-" & SelMonth)))
			RETURN
			CALCULATE(
			    SUM(fact_master_bdx_switched_on[TotalRetail]),
			    ALL(fact_master_bdx_switched_on[Month]),
			    fact_master_bdx_switched_on[IssueDate] >= CohortStart,
			    fact_master_bdx_switched_on[IssueDate] <= CohortEnd,
			    IF(ISBLANK(SelKey), TRUE(), fact_master_bdx_switched_on[MonthSortKey] <= SelKey)
			)
		formatString: #,##0
		displayFolder: Cumulative (UW Year)
		lineageTag: b6669ef3-d48c-48fd-8490-44531395d94e

	column Month
		dataType: string
		lineageTag: 58f85c0e-fa6e-47f2-a517-11ea06004637
		summarizeBy: none
		sourceColumn: Month
		sortByColumn: MonthSortKey

		annotation SummarizationSetBy = Automatic

	column ID
		dataType: int64
