table FactEnquiries
	lineageTag: cb3a0169-2694-4cde-acbe-46542f42446e

	measure TravelEnquiryCount =
			
			ROUND(COUNT('FactEnquiries'[TravelEnquiryId]), 2)
		formatString: 0
		lineageTag: 834e40fa-87c6-47ec-b85e-af3ce148972e

	measure AvgQuotesPerEnquiry =
			
			DIVIDE(
			    SUM('FactEnquiries'[NoOfQuotes]),
			    COUNT('FactEnquiries'[TravelEnquiryId]),
			    0
			)
		lineageTag: c5609c03-6efd-48d8-8c00-5cd2ab217c58

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure EnquiriesConversionRate = ```
			
			DIVIDE(
			    SUM('FactEnquiries'[IsSold]),
			    COUNT('FactEnquiries'[TravelEnquiryID]),
			    0
			)
			
			```
		formatString: 0.000
		lineageTag: ad8968ae-756f-4d29-8569-efdefb7c9084

	measure DurationEnquiries = ```
			
			IF(
			    HASONEVALUE(DimDuration[Duration]),
			    
			    // Row-level calculation
			    VAR BaseTotal = 
			        CALCULATE(
			            SUM(FactEnquiries[IsQuoted]),
			            REMOVEFILTERS(DimDuration),
			            DimDuration[Duration] IN { "1 to 3", "4 to 5", "6 to 10", "11 to 17", "18 to 24", "25 to 31", "32 +"}
			        )
			    VAR TripValue = SELECTEDVALUE(DimDuration[SingleTrip])
			    RETURN DIVIDE(BaseTotal * TripValue, 100),
			    
			    // Total row logic
			    SUMX(
			        VALUES(DimDuration[Duration]),
			        VAR DurationValue = [Duration]
			        VAR TripValue = 
			            LOOKUPVALUE(
			                DimDuration[SingleTrip],
			                DimDuration[Duration], DurationValue
			            )
			        VAR BaseTotal = 
			            CALCULATE(
			                SUM(FactEnquiries[IsQuoted]),
			                REMOVEFILTERS(DimLeadTimeGroup),
			                DimDuration[Duration] IN { "1 to 3", "4 to 5", "6 to 10", "11 to 17", "18 to 24", "25 to 31", "32 +"}
			            )
			        RETURN DIVIDE(BaseTotal * TripValue, 100)
			    )
			)
			
			```
		formatString: 0
		lineageTag: 692028ea-985e-4ad3-bd8b-a2ef65b96402

		annotation PBI_FormatHint = {"isDecimal":true}

	measure DurationConversionRate =
			
			DIVIDE(
			    SUM(FactSales[TotalSaleVolume]),
			    SUM(FactEnquiries[IsQuoted])
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 2baf48e2-bc3e-4cae-af73-422e708e6d82

	measure LeadTimeGroupConversionRate =
			
			DIVIDE(
			    SUM(FactSales[TotalSaleVolume]),
			    SUM(FactEnquiries[IsQuoted])
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a38fb947-6699-4379-9d89-cc92bc2dca83

	measure MedicalScoreConversionRate =
			
			DIVIDE(
			    SUM(FactSales[TotalSaleVolume]),
			    SUM(FactEnquiries[IsQuoted])
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 483087d7-da94-4711-867d-5fc9f5e4e065

	measure AgeGroupAMTConversionRate = ```
			
			DIVIDE(
			    SUM('FactEnquiries'[IsSold]),
			    COUNT('FactEnquiries'[TravelEnquiryID]),
			    0
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c4e119ec-817b-4a26-aeac-f1c82c169a77

	measure AgeGroupSingleConversionRate = ```
			
			DIVIDE(
			    SUM('FactEnquiries'[IsSold]),
			    COUNT('FactEnquiries'[TravelEnquiryID]),
			    0
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d7ef11e9-6c19-4164-a206-02720b00c159

