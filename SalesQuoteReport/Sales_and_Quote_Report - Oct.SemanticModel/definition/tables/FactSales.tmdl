			        )
			    VAR TripValue = SELECTEDVALUE(DimLeadTimeGroup[SingleTrip])
			    RETURN DIVIDE(BaseTotal * TripValue, 100),
			    
			    // Total row logic
			    SUMX(
			        VALUES(DimLeadTimeGroup[LeadTimeGroup]),
			        VAR LeadTimeGroupValue = [LeadTimeGroup]
			        VAR TripValue = 
			            LOOKUPVALUE(
			                DimLeadTimeGroup[SingleTrip],
			                DimLeadTimeGroup[LeadTimeGroup], LeadTimeGroupValue
			            )
			        VAR BaseTotal = 
			            CALCULATE(
			                SUM(FactSales[TotalGrossExcIPT]),
			                REMOVEFILTERS(DimLeadTimeGroup),
			                DimLeadTimeGroup[LeadTimeGroup] IN { "0 to 3", "4 to 8", "16 to 30", "31 to 60", "61+", "9 to 15"}
			            )
			        RETURN DIVIDE(BaseTotal * TripValue, 100)
			    )
			)
			
			
			```
		lineageTag: be98db3b-2b28-496b-840e-91be36032de6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure VolumeStatus = ```
			
			VAR Difference = [VariancePer]
			VAR ThresholdAmber = -0.4 * SUM(FactSales[TotalSaleVolume])
			RETURN
			    SWITCH(
			        TRUE(),
			        Difference > 0, "Up",
			        Difference <= 0 && Difference >= ThresholdAmber, "Amber",
			        Difference < ThresholdAmber, "Down"
			    )
			
			```
		lineageTag: 730b02a8-77ff-4c32-b496-2abd92ac802a

	measure VolumeTrendIconOnly = ```
			
			VAR Difference = [VariancePer]
			VAR ThresholdAmber = -0.4 * SUM(FactSales[TotalSaleVolume])
			RETURN
			    SWITCH(
			        TRUE(),
			        Difference > 0, "🟢 ▲",         // Green circle + up arrow
			        Difference <= 0 && Difference >= ThresholdAmber, "🟠 ▼",  // Amber circle + down arrow
			        Difference < ThresholdAmber, "🔴 ▼"         // Red circle + down arrow
			    )
			
			```
		lineageTag: 238bfcae-90a7-4292-8ec8-c86143d25c2a

	measure LeadTimeGroupGrossDifferences =
			
			VAR GrossDiff = SUM(FactSales[TotalGrossExcIPT]) - [LeadTimeGroupForecastGross]
			RETURN
			SWITCH(
			    TRUE(),
			    ABS(GrossDiff) >= 1000000000, FORMAT(GrossDiff / 1000000000, "0.00") & "B",
			    ABS(GrossDiff) >= 1000000, FORMAT(GrossDiff / 1000000, "0.00") & "M",
			    ABS(GrossDiff) >= 1000, FORMAT(GrossDiff / 1000, "0") & "K",
			    FORMAT(GrossDiff, "0")
			)
		lineageTag: cc9c3ef2-b9d5-4ae8-b39d-05b5ae4e74bb

	measure MedicalScoreForecastVolume = ```
			
			IF(
			    HASONEVALUE(DimMedicalScore[MedicalScore]),
			    
			    // Row-level calculation
			    VAR BaseTotal = 
			        CALCULATE(
			            SUM(FactSales[TotalSaleVolume]),
			            REMOVEFILTERS(DimMedicalScore),
			            DimMedicalScore[MedicalScore] IN { 
			                "0 to 0.99", "1.00", "1.01 to 1.5", 
			                "1.51 to 2.5", "2.51 to 6.0", "6.01 +", BLANK()
			            }
			        )
			    VAR TripValue = SELECTEDVALUE(DimMedicalScore[SingleTrip])
			    RETURN DIVIDE(BaseTotal * TripValue, 100),
			    
			    // Total row logic
			    SUMX(
			        VALUES(DimMedicalScore[MedicalScore]),
			        VAR MedicalScoreValue = [MedicalScore]
			        VAR TripValue = 
			            LOOKUPVALUE(
			                DimMedicalScore[SingleTrip],
			                DimMedicalScore[MedicalScore], MedicalScoreValue
			            )
			        VAR BaseTotal = 
			            CALCULATE(
			                SUM(FactSales[TotalSaleVolume]),
			                REMOVEFILTERS(DimMedicalScore),
			                DimMedicalScore[MedicalScore] IN { 
			                    "0 to 0.99", "1.00", "1.01 to 1.5", 
			                    "1.51 to 2.5", "2.51 to 6.0", "6.01 +", BLANK()
			                }
			            )
			        RETURN DIVIDE(BaseTotal * TripValue, 100)
			    )
			)
			
			```
