			        VAR TripValue = 
			            LOOKUPVALUE(
			                DimAgeGroup[AMT],
			                DimAgeGroup[AgeGroup], MedicalScoreValue
			            )
			        VAR BaseTotal = 
			            CALCULATE(
			                SUM(FactSales[TotalGrossExcIPT]),
			                REMOVEFILTERS(DimAgeGroup),
			                DimAgeGroup[AgeGroup] IN { 
			                    "0 to 20", "21 to 30", "31 to 40", 
			                "41 to 50", "51 to 65", "66 to 75", "76 +", BLANK()
			                }
			            )
			        RETURN DIVIDE(BaseTotal * TripValue, 100)
			    )
			)
			
			```
		lineageTag: e58cd66d-3cac-4873-b13b-257058d0767f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure AgeGroupAMTGrossDifferences =
			
			VAR GrossDiff = SUM(FactSales[TotalGrossExcIPT]) - [AgeGroupAMTForecastGross]
			RETURN
			SWITCH(
			    TRUE(),
			    ABS(GrossDiff) >= 1000000000, FORMAT(GrossDiff / 1000000000, "0.00") & "B",
			    ABS(GrossDiff) >= 1000000, FORMAT(GrossDiff / 1000000, "0.00") & "M",
			    ABS(GrossDiff) >= 1000, FORMAT(GrossDiff / 1000, "0") & "K",
			    FORMAT(GrossDiff, "0")
			)
		lineageTag: cb8e4afe-cbef-44de-b72c-8711ef7c5ef5

	measure AgeGroupAMTVolumeDifferences =
			
			DIVIDE(
			    SUM(FactSales[TotalSaleVolume]) - [AgeGroupAMTForecastVolume],
			    [AgeGroupAMTForecastVolume],
			    0
			)
		lineageTag: 1f2e419a-b273-4024-92d9-f74103943dec

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure AgeGroupAMTVolumeTrendIconOnly = ```
			
			VAR ForecastVolume = [AgeGroupAMTForecastVolume]
			VAR ActualVolume = SUM(FactSales[TotalSaleVolume])
			VAR Difference = ActualVolume - ForecastVolume
			VAR ThresholdAmber = -0.4 * ActualVolume
			RETURN
			    SWITCH(
			        TRUE(),
			        Difference > 0, "🟢 ▲",         
			        Difference <= 0 && Difference >= ThresholdAmber, "🟠 ▼",  
			        Difference < ThresholdAmber, "🔴 ▼"         
			    )
			
			```
		lineageTag: 3407336c-55a1-4969-9c76-76931509a555

