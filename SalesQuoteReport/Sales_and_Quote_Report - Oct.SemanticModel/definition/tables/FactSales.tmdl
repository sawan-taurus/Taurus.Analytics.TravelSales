	column OasisAtozNetMargin = ```
			
			VAR NetToUnderwriter = 'FactSales'[TotalNetToUnderwriter]
			VAR AggCommPct = RELATED('DimMarketingChannel'[AggComm]) / 100
			RETURN
			(NetToUnderwriter / (1 + AggCommPct)) * AggCommPct
			
