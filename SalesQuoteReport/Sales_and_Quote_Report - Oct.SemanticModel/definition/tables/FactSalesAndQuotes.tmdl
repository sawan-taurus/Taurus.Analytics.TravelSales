table FactSalesAndQuotes
	lineageTag: fbc36611-9bff-4698-a113-9ee38cada386

	measure TotalSalesFormatted = ```
			
			VAR Total = SUM('FactSalesAndQuotes'[TotalSales])
			RETURN IF(Total = 0 || ISBLANK(Total), BLANK(), FORMAT(Total, "#,##0.00"))
			
			
			```
		lineageTag: 7d8d5036-b253-4bf7-9192-7855c2eddf33

	measure DurationForecastVol = ```
			
			IF(
			    HASONEVALUE(DimDuration[Duration]),
			    
			    // Row-level calculation
			    VAR BaseTotal = 
			        CALCULATE(
			            SUM(FactSalesAndQuotes[TotalSales]),
			            REMOVEFILTERS(DimDuration),
			            DimDuration[Duration] IN { "1 to 3", "4 to 5", "6 to 10", "11 to 17", "18 to 24", "25 to 31", "32 +"}
			        )
			    VAR TripValue = SELECTEDVALUE(DimDuration[SingleTrip])
			    RETURN DIVIDE(BaseTotal * TripValue, 100),
			    
			    // Total row logic
			    SUMX(
			        VALUES(DimDuration[Duration]),
			        VAR DurationValue = [Duration]
			        VAR TripValue = 
			            LOOKUPVALUE(
			                DimDuration[SingleTrip],
			                DimDuration[Duration], DurationValue
			            )
			        VAR BaseTotal = 
			            CALCULATE(
			                SUM(FactSalesAndQuotes[TotalSales]),
			                REMOVEFILTERS(DimLeadTimeGroup),
			                DimDuration[Duration] IN { "1 to 3", "4 to 5", "6 to 10", "11 to 17", "18 to 24", "25 to 31", "32 +"}
			            )
			        RETURN DIVIDE(BaseTotal * TripValue, 100)
			    )
			)
			
			```
		lineageTag: c2091295-5f9b-450b-9fbc-244bf78bceca

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure DurationActualPerPer = ```
			
			    IF(HASONEVALUE(DimDuration[Duration]),
			    FORMAT(DIVIDE(SUM(FactSalesAndQuotes[TotalSales]),
			    CALCULATE(SUM(FactSalesAndQuotes[TotalSales]),
			    REMOVEFILTERS(DimDuration)),0)
			*100,"0.00")
			& "%","100.00%")
			```
		lineageTag: 4476452c-1302-4fbd-a461-13cdd68ac164

	measure DurationVolumeDiff =
			
			DIVIDE(
			    SUM(FactSalesAndQuotes[TotalSales]) - [DurationForecastVolume],
			    [DurationForecastVolume],
			    0
			)
		lineageTag: ee6c4837-b27a-4c2b-9f71-c987fe26e585

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure DurationVarianceSQ = ```
			
			    IF(HASONEVALUE(DimDuration[Duration]),
			    FORMAT([DurationActualPerPer]-VALUES(DimDuration[SingleTrip]),
			    "0.00")& "%",BLANK()
			)
			```
		lineageTag: 77074338-b0d2-4099-b3eb-2668bcc3b907

	measure MedicalScoreActualPerPer = ```
			
			    IF(HASONEVALUE(DimMedicalScore[MedicalScore]),
			    FORMAT(DIVIDE(SUM(FactSalesAndQuotes[TotalSales]),
			    CALCULATE(SUM(FactSalesAndQuotes[TotalSales]),
			    REMOVEFILTERS(DimMedicalScore)),0)
			*100,"0.00")
			& "%","100.00%")
			```
		lineageTag: 3f266902-c590-49cb-84a1-d4c11ae16ff7

	measure MedicalScoreSingleForecastVol = ```
			
			IF(
			    HASONEVALUE(DimMedicalScore[MedicalScore]),
			    
			    // Row-level calculation
			    VAR BaseTotal = 
			        CALCULATE(
			            SUM(FactSalesAndQuotes[TotalSales]),
			            REMOVEFILTERS(DimMedicalScore),
			            DimMedicalScore[MedicalScore] IN { 
			                "0 to 0.99", "1.00", "1.01 to 1.5", 
			                "1.51 to 2.5", "2.51 to 6.0", "6.01 +", BLANK()
			            }
			        )
			    VAR TripValue = SELECTEDVALUE(DimMedicalScore[SingleTrip])
			    RETURN DIVIDE(BaseTotal * TripValue, 100),
			    
			    // Total row logic
			    SUMX(
			        VALUES(DimMedicalScore[MedicalScore]),
			        VAR MedicalScoreValue = [MedicalScore]
			        VAR TripValue = 
			            LOOKUPVALUE(
			                DimMedicalScore[SingleTrip],
			                DimMedicalScore[MedicalScore], MedicalScoreValue
			            )
			        VAR BaseTotal = 
			            CALCULATE(
			                SUM(FactSalesAndQuotes[TotalSales]),
			                REMOVEFILTERS(DimMedicalScore),
			                DimMedicalScore[MedicalScore] IN { 
			                    "0 to 0.99", "1.00", "1.01 to 1.5", 
			                    "1.51 to 2.5", "2.51 to 6.0", "6.01 +", BLANK()
			                }
			            )
			        RETURN DIVIDE(BaseTotal * TripValue, 100)
			    )
			)
			
			```
		lineageTag: dcdc1b1f-3d57-42a5-b6d7-34ad4909de3b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MedicalScoreAMTForecastVol = ```
			
			IF(
			    HASONEVALUE(DimMedicalScore[MedicalScore]),
			    
			    // Row-level calculation
			    VAR BaseTotal = 
			        CALCULATE(
			            SUM(FactSalesAndQuotes[TotalSales]),
			            REMOVEFILTERS(DimMedicalScore),
			            DimMedicalScore[MedicalScore] IN { 
			                "0 to 0.99", "1.00", "1.01 to 1.5", 
			                "1.51 to 2.5", "2.51 to 6.0", "6.01 +", BLANK()
			            }
			        )
			    VAR TripValue = SELECTEDVALUE(DimMedicalScore[AMT])
			    RETURN DIVIDE(BaseTotal * TripValue, 100),
			    
			    // Total row logic
			    SUMX(
			        VALUES(DimMedicalScore[MedicalScore]),
			        VAR MedicalScoreValue = [MedicalScore]
			        VAR TripValue = 
			            LOOKUPVALUE(
			                DimMedicalScore[AMT],
			                DimMedicalScore[MedicalScore], MedicalScoreValue
			            )
			        VAR BaseTotal = 
			            CALCULATE(
			                SUM(FactSalesAndQuotes[TotalSales]),
			                REMOVEFILTERS(DimMedicalScore),
			                DimMedicalScore[MedicalScore] IN { 
			                    "0 to 0.99", "1.00", "1.01 to 1.5", 
			                    "1.51 to 2.5", "2.51 to 6.0", "6.01 +", BLANK()
			                }
			            )
			        RETURN DIVIDE(BaseTotal * TripValue, 100)
			    )
			)
			
			```
		lineageTag: 8325f7cf-d252-4195-9624-5c75bf019e09

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ConversionRate = ```
			
			DIVIDE(
			    SUM('FactSalesAndQuotes'[TotalSales]),
			    SUM('FactSalesAndQuotes'[TotalEnquiry]),
			    0
			)
			
			```
		formatString: 0.0000
		lineageTag: f1db754c-ab57-4a2b-880f-bb5463747d30

